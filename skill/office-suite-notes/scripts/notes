  echo "$resp_body" | python3 -c "
import json, sys
d = json.load(sys.stdin)['data']
parent = d.get('parent_id')
parent_str = 'root' if parent is None else f'→ {parent}'
print(f\"Updated: {d['id']} - {d['name']} ({parent_str})\")
"
}

cmd_folder_notes() {
  if [[ $# -eq 0 ]]; then
    echo "Error: folder id is required"
    exit 1
  fi
  local id="$1"; shift
  local limit="20" page="1" json_flag=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit=*) limit="${1#*=}" ;;
      --page=*) page="${1#*=}" ;;
      --json) json_flag="1" ;;
      *) shift; continue ;;
    esac
    shift
  done

  if [[ -z "$id" ]]; then
    echo "Error: folder id is required"
    exit 1
  fi

  local resp body
  resp=$(http_get "${BASE_URL}/folders/${id}/notes?limit=${limit}&page=${page}")
  body=$(strip_http_code "$resp")
  if [[ -n "$json_flag" ]]; then
    echo "$body"
    return
  fi

  local status
  status=$(echo "$body" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('status',''))" 2>/dev/null || true)
  if [[ "$status" != "success" ]]; then
    print_response_error "$resp"
    return
  fi

  echo "$body" | python3 -c "
import json, sys
d = json.load(sys.stdin)
data = d.get('data', [])
meta = d.get('meta', {})
for i, note in enumerate(data, 1):
    print(f\"{i}. [{note['id']}] {note['title']}  ({note['folder']})\")
print('---')
total = meta.get('total', len(data))
page = meta.get('page', 1)
page_size = meta.get('page_size', len(data))
total_pages = -(-total // page_size) if page_size > 0 else 1
print(f\"Total: {total} (page {page}/{total_pages})\")
"
}

# ---------- cli:check ----------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
default_codex_root="${CODEX_HOME:-${HOME}/.codex}"
if [[ -f "${SCRIPT_DIR}/../SKILL.md" ]]; then
  CLI_SKILL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
elif [[ -f "${default_codex_root}/skills/office-suite-notes/SKILL.md" ]]; then
  CLI_SKILL_DIR="${default_codex_root}/skills/office-suite-notes"
elif [[ -f "/Applications/pcsuite.app/Contents/Resources/skills/office-suite-notes/SKILL.md" ]]; then
  CLI_SKILL_DIR="/Applications/pcsuite.app/Contents/Resources/skills/office-suite-notes"
else
  CLI_SKILL_DIR="${SCRIPT_DIR}"
fi

get_local_skill_version() {
  local skill_file="${CLI_SKILL_DIR}/SKILL.md"
  if [[ ! -f "$skill_file" ]]; then
    echo "unknown"
    return
  fi
  python3 -c "
import re, sys
try:
    content = open(sys.argv[1], encoding='utf-8').read()
    m = re.search(r'^\s*version:\s*[\"\']?([\w.\-]+)[\"\']?', content, re.MULTILINE)
    print(m.group(1) if m else 'unknown')
except Exception:
    print('unknown')
" "$skill_file"
}

cmd_cli_check() {
  local resp body status
  resp=$(http_get "${BASE_URL}/cli/version" 2>&1) || {
    echo "Error: Cannot connect to ${BASE_URL}"
    echo "Please check if Office Suite is running."
    exit 1
  }
  body=$(strip_http_code "$resp")
  status=$(echo "$body" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('status',''))" 2>/dev/null || true)
  if [[ "$status" != "success" ]]; then
    print_response_error "$resp"
    return
  fi

  local local_skill
  local_skill=$(get_local_skill_version)
  local remote_skill upgrade_prompt
  remote_skill=$(echo "$body" | python3 -c "import json,sys; print(json.load(sys.stdin).get('data',{}).get('skill_version','unknown'))" 2>/dev/null || echo "unknown")
  upgrade_prompt=$(echo "$body" | python3 -c "import json,sys; print(json.load(sys.stdin).get('data',{}).get('upgrade_prompt',''))" 2>/dev/null || echo "")

  echo "Current version:"
  echo "  Skill: ${local_skill}"
  echo "  Path:  ${CLI_SKILL_DIR}/SKILL.md"
  echo "Latest version:"
  echo "  Skill: ${remote_skill}"
  if [[ -n "$upgrade_prompt" ]]; then
    echo "Upgrade prompt:"
    echo "${upgrade_prompt}"
  fi
  echo "---"

  if [[ "$local_skill" != "$remote_skill" ]]; then
    echo "Status: update available"
  else
    echo "Status: up to date"
  fi
}

cmd_config() {
  local token="" port="" show_only=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --token=*) token="${1#*=}"; show_only="" ;;
      --port=*) port="${1#*=}"; show_only="" ;;
      *) shift; continue ;;
    esac
    shift
  done

  if [[ -n "$show_only" ]]; then
    echo "Current config:"
    if [[ -n "${NOTES_TOKEN:-}" ]]; then
      echo "  Token: configured"
    else
      echo "  Token: not configured"
    fi
    echo "  Port:  ${NOTES_PORT}"
    echo "  Config file: ${CONFIG_FILE}"
    return
  fi

  if [[ -n "$port" && ! "$port" =~ ^[0-9]+$ ]]; then
    echo "Error: --port must be an integer"
    exit 1
  fi
  if [[ -n "$port" && ( "$port" -lt 9200 || "$port" -gt 9700 ) ]]; then
    echo "Error: --port must be between 9200 and 9700"
    exit 1
  fi
  if [[ "$token" == *$'\n'* || "$token" == *$'\r'* ]]; then
    echo "Error: token must not contain line breaks"
    exit 1
  fi

  local effective_token="${token:-${NOTES_TOKEN:-}}"
  local effective_port="${port:-${NOTES_PORT:-9200}}"
  mkdir -p "$(dirname "$CONFIG_FILE")"
  umask 077
  {
    printf 'NOTES_TOKEN=%s\n' "$effective_token"
    printf 'NOTES_PORT=%s\n' "$effective_port"
  } > "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"

  echo "Config saved to ${CONFIG_FILE} (permissions 600)"
  echo "Current config:"
  if [[ -n "$effective_token" ]]; then
    echo "  Token: configured"
  else
    echo "  Token: not configured"
  fi
  echo "  Port:  ${effective_port}"
  echo ""
  echo "Subsequent commands will read this config automatically."
}

# ---------- main ----------
usage() {
  echo "Notes CLI v${CLI_VERSION}"
  echo ""
  echo "Usage: notes <command> [options]"
  echo ""
  echo "Commands:"
  echo "  health                  Check server connectivity"
  echo "  version                 Show App version"
  echo "  list    [--folder=] [--limit=20] [--page=1] [--json]"
  echo "  read    <id> [--json]"
  echo "  create  --title= [--content=] [--content-b64=] [--folder=] [--json]"
  echo "  update  <id> [--title=] [--content=] [--content-b64=] [--folder=] [--json]"
  echo "  search  --query= [--limit=10] [--folder=] [--json]"
  echo "  folders [--parent=] [--json]"
  echo "  folder  <id> [--json]"
  echo "  folder:create  --name= [--parent=] [--json]"
  echo "  folder:update  <id> [--name=] [--parent=] [--json]"
  echo "  folder:notes   <id> [--limit=20] [--page=1] [--json]"
  echo "  config  [--token=] [--port=]"
  echo "  cli:check                 Check CLI/Skill update"
  echo ""
  echo "For JSON output, add --json to any command."
}

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

case "$1" in
  health) shift; cmd_health "$@" ;;
  version) shift; cmd_version "$@" ;;
  list) shift; cmd_list "$@" ;;
  read) shift; cmd_read "$@" ;;
  create) shift; cmd_create "$@" ;;
  update) shift; cmd_update "$@" ;;
  search) shift; cmd_search "$@" ;;
  folders) shift; cmd_folders "$@" ;;
  folder) shift; cmd_folder "$@" ;;
  folder:create) shift; cmd_folder_create "$@" ;;
  folder:update) shift; cmd_folder_update "$@" ;;
  folder:notes) shift; cmd_folder_notes "$@" ;;
  config) shift; cmd_config "$@" ;;
  cli:check) shift; cmd_cli_check "$@" ;;
  -h|--help|help) usage ;;
  *) echo "Unknown command: $1"; usage; exit 1 ;;
esac
